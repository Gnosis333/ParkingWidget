<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.parkingwidget">

    <!-- BLE 권한 (Android 11 이하) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- BLE 권한 (Android 12+) -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Android 11 이하 BLE 스캔에 위치 권한 필요 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- 백그라운드 BLE 스캔 결과 수신에 필수 ("항상 허용" 위치).
         BLUETOOTH_SCAN에 neverForLocation을 안 쓰는 한(iBeacon 앵커가 필터링될 수 있어 못 씀)
         스캔 결과는 위치 정보로 취급되어, 앱이 화면에 없으면 이 권한 없이는
         에러 없이 조용히 차단된다 (2026-07-12 실측: appops rejectTime으로 확인). -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- 부팅 후 서비스 재시작 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Foreground Service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 배터리 최적화 예외 요청 (백그라운드 상시 스캔 생존용) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Android 14+: Bluetooth foreground service 타입 선언 필요 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.Light">

        <!-- 최초 1회 권한 요청용 액티비티 -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 위젯 프로바이더 -->
        <receiver
            android:name=".ParkingWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.parkingwidget.ACTION_SELECT_F1" />
                <action android:name="com.example.parkingwidget.ACTION_SELECT_F2" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/parking_widget_info" />
        </receiver>

        <!-- 부팅 후 상시 스캔 서비스 재시작 -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Doze 대응 워치독 (AlarmManager → 서비스 생존 확인·부활) -->
        <receiver
            android:name=".WatchdogReceiver"
            android:exported="false" />

        <!-- BLE 상시 스캔 Foreground Service -->
        <service
            android:name=".BleMonitorService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

    </application>

</manifest>
